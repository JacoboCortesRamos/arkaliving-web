  font-size: 28px;
  text-shadow: 0 2px 22px rgba(0, 0, 0, 0.35);
}

.steps {
  margin: 0;
  padding: 0;
  list-style: none;
  max-width: 820px;
  width: 100%;
  display: grid;
  gap: 18px;
}

/* ===== NUEVA ESTRUCTURA DE STEP ===== */

.step {
  display: flex;
  align-items: flex-start;
  gap: 18px;

  color: #fff;
  font-size: 22px;
  line-height: 1.2;
  text-shadow: 0 2px 22px rgba(0, 0, 0, 0.35);
  opacity: 0.95;
}

/* Columna fija izquierda */
.stepIconWrap {
  flex: 0 0 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(2px);
}

/* Icono */
