  width: 24px;
  height: 24px;
  color: #fff;
}

/* Texto */
.stepText {
  flex: 1;
  min-width: 0;
}

/* ============================= */
/* Scroll Indicator              */
/* ============================= */

.scrollIndicator {
  position: fixed;
  bottom: 36px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  background: transparent;
  border: 0;
  padding: 0;
  cursor: pointer;
}

.scrollCircle {
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  border-radius: 999px;
  background: rgba(140, 140, 140, 0.22);
  backdrop-filter: blur(2px);
}

.scrollArrow {
  width: 18px;
  height: 18px;
  border-left: 3px solid white;
  border-bottom: 3px solid white;
  transform: rotate(-45deg);
  animation: scrollBlink 1.4s ease-in-out infinite;
}

@keyframes scrollBlink {
  0% {
    transform: translateY(-8px) rotate(-45deg);
    opacity: 0.2;
  }
  50% {
    transform: translateY(3px) rotate(-45deg);
    opacity: 1;
  }
  100% {
    transform: translateY(-8px) rotate(-45deg);
    opacity: 0.2;
  }
}

/* Tablet / Mobile */
@media (max-width: 1024px) {
  .scrollIndicator {
    bottom: 92px;
  }

  .h1Wrap {
    top: 65%;
    bottom: auto;
    transform: translateY(-50%);
  }

  .step {
    font-size: 18px;
    gap: 14px;
  }

  .stepIconWrap {
    flex: 0 0 36px;
    height: 36px;
  }

  .stepIcon {
    width: 20px;
    height: 20px;
  }
}

/* Ocultar scroll indicator en último stage */
html[data-hero-stage="7"] .scrollIndicator,
html[data-hero-stage="7"] .scrollCircle {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .scrollArrow {
    animation: none !important;
  }
}
