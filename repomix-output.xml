  inset: 0;
  z-index: 10004;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px var(--edge-space);
}

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(74, 52, 36, 0.55);
