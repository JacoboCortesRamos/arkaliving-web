.foundersSection {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 var(--edge-space) 80px;
}

.foundersGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  padding-top: 52px; /* espacio para que el círculo sobresalga sin clippearse */
}

/* ── Card ── */
.founderCard {
  position: relative;
  border: 1px solid rgba(167, 126, 77, 0.2);
  border-radius: 20px;
  background: var(--arka-white);
  display: flex;
  flex-direction: column;
  overflow: visible; /* permite que el círculo sobresalga */
  transition:
    box-shadow 260ms ease,
    transform 260ms ease;
}

.founderCard:hover {
  box-shadow: 0 12px 40px rgba(74, 52, 36, 0.1);
  transform: translateY(-3px);
}

/* ── Cabecera: círculo + firma ── */
.founderHeader {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 0 28px;
  /* el círculo sobresale por arriba: margin-top negativo = radio del círculo */
  margin-top: -44px; /* mitad del círculo de 88px */
  min-height: 88px;
}

/* Círculo de foto — sobresale del borde superior de la card */
.founderCircle {
  position: relative;
  flex-shrink: 0;
  width: 88px;
  height: 88px;
  border-radius: 999px;
  background: rgba(167, 126, 77, 0.1);
  border: 3px solid var(--arka-white);
  box-shadow: 0 4px 16px rgba(74, 52, 36, 0.12);
  display: grid;
  place-items: center;
  overflow: hidden; /* contiene la foto cuando la agregues */
}

/*
  Cuando agregues la foto real, usa esta clase en el <Image>:
  className={styles.founderCircleImg}
*/
.founderCircleImg {
  object-fit: cover;
  object-position: center top;
}

.founderInitial {
  font-family: var(--font-display, Georgia, serif);
  font-size: 32px;
  font-weight: 700;
  color: rgba(167, 126, 77, 0.4);
  line-height: 1;
  user-select: none;
}

/* Área de firma — a la derecha del círculo */
.founderSignaturePlaceholder {
  flex: 1;
  height: 40px;
  border-bottom: 1.5px solid rgba(167, 126, 77, 0.28);
  border-radius: 0;
}

/*
  Cuando tengas el PNG/SVG de la firma, usa:
  className={styles.founderSignature}
*/
.founderSignature {
  flex-shrink: 0;
  height: 44px;
  width: auto;
  max-width: 160px;
  object-fit: contain;
  opacity: 0.72;
}

/* ── Cuerpo ── */
.founderBody {
  padding: 16px 28px 28px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.founderName {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  color: var(--arka-brown-dark);
  line-height: 1.2;
}

.founderRole {
  margin: 0;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--arka-brown-mid);
}

.founderBio {
  margin: 10px 0 0;
  font-size: 14px;
  line-height: 1.72;
  color: var(--arka-text-soft);
  flex: 1;
}

/* ─── RESPONSIVE ─────────────────────────────────────────── */

@media (max-width: 680px) {
  .foundersGrid {
    grid-template-columns: 1fr;
  }

  .pullQuote {
    padding-left: 20px;
  }

  .visionCard {
    padding: 28px 24px;
  }

  .founderHeader {
    padding: 0 20px;
  }

  .founderBody {
    padding: 16px 20px 24px;
  }
}

@media (max-width: 420px) {
  .heroTitleLine {
    font-size: 32px;
  }
}

/* ─── ACCESIBILIDAD ──────────────────────────────────────── */

@media (prefers-reduced-motion: reduce) {
  .revealFade,
  .revealUp,
  .revealScale {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}
