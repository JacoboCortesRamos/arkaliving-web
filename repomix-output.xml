  overflow: hidden;
}

.media {
  position: fixed;
  inset: 0;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background: linear-gradient(
    180deg,
    var(--arka-white) 0%,
    var(--arka-white) 10%,
    var(--arka-brown-mid) 80%
  );
  z-index: 0;
  pointer-events: none;
}

.mediaVideo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  top: 50%;
  left: 50%;
  translate: -50% -50%;
}

/* Overlay progresivo */
.overlay {
  position: fixed;
  inset: 0;
  height: 100vh;
  width: 100vw;
  background: linear-gradient(
    180deg,
    var(--arka-brown-light) 0%,
    var(--arka-brown-mid) 10%,
    var(--arka-brown-dark) 80%
  );
  opacity: 0;
  transition: opacity 120ms linear;
  z-index: 1;
  pointer-events: none;
}

/* Brand */
.brand {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 3;
  pointer-events: none;
  transition: transform 320ms ease;
}

.brandInner {
  display: grid;
  place-items: center;
  gap: 12px;
  text-align: center;
  padding: 0 16px;

  opacity: 1;
  filter: saturate(0);
  transition:
    opacity 320ms ease,
    filter 320ms ease,
    transform 320ms ease;
}

.logo {
  width: clamp(220px, 26vw, 380px);
  height: auto;
  filter: drop-shadow(0 16px 44px rgba(0, 0, 0, 0.2));
}

.slogan {
  margin: 0;
  font-weight: 300;
  letter-spacing: 0.2px;
  color: #fff;
  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.3);
  font-size: clamp(16px, 3vw, 25px);
  transform: translateY(-15px);
}

/* Compact brand */
.brandCompact {
  transform: translateY(calc(-22vh + var(--header-h) * 0.55));
}

.brandCompact .brandInner {
  opacity: 0.92;
  filter: saturate(1);
  transform: scale(0.82);
}

/* H1 */
.h1Wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 10vh;
  z-index: 2;
  pointer-events: none;
  padding: 0 20px;
  display: grid;
  place-items: center;
}

.h1 {
  margin: 0;
  max-width: 1100px;
  width: 100%;
  text-align: center;
  color: #fff;
  font-size: clamp(30px, 5vw, 58px);
  line-height: 1.05;
  text-shadow: 0 2px 26px rgba(0, 0, 0, 0.4);
}

/* ============================= */
/* H3 + Steps                    */
/* ============================= */

.stepsWrap {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(var(--header-h) + 65px);
  z-index: 3;
  pointer-events: none;
  padding: 0 20px;
