  outline: none;
  transition:
    border-color 200ms ease,
    box-shadow 200ms ease;
  box-sizing: border-box;
}

.input::placeholder,
.textarea::placeholder {
  color: rgba(111, 91, 75, 0.45);
}

.input:focus,
.textarea:focus {
  border-color: var(--arka-brown-mid);
  box-shadow: 0 0 0 3px rgba(167, 126, 77, 0.12);
}

.input:disabled,
.textarea:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.textarea {
  resize: vertical;
  min-height: 130px;
  line-height: 1.6;
}

.fieldError {
  font-size: 12px;
  color: #b94a3a;
  margin: 0;
}

/* ─── SUBMIT BTN ─────────────────────────────────────────── */

.submitBtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 24px;
  background: var(--arka-brown-dark);
  color: var(--arka-white);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition:
    background 220ms ease,
    transform 220ms ease,
    box-shadow 220ms ease;
  margin-top: 8px;
}

.submitBtn:hover:not(:disabled) {
  background: var(--arka-brown-mid);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(74, 52, 36, 0.16);
}

.submitBtn:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.submitBtn svg {
  width: 18px;
  height: 18px;
}

/* ─── ESTADOS: ÉXITO / ERROR ─────────────────────────────── */

.statusSuccess {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 20px 22px;
  background: rgba(74, 52, 36, 0.05);
  border: 1.5px solid rgba(167, 126, 77, 0.35);
  border-radius: 12px;
  text-align: left;
}

.statusSuccess svg {
  width: 22px;
  height: 22px;
  color: var(--arka-brown-mid);
  flex-shrink: 0;
  margin-top: 2px;
}

.statusSuccessText strong {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: var(--arka-brown-dark);
  margin-bottom: 4px;
}

.statusSuccessText span {
  font-size: 14px;
  color: var(--arka-text-soft);
  line-height: 1.5;
}

.statusError {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  background: rgba(185, 74, 58, 0.06);
  border: 1.5px solid rgba(185, 74, 58, 0.25);
  border-radius: 10px;
  font-size: 14px;
  color: #b94a3a;
  text-align: left;
}

.statusError svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

/* ─── BLOQUE 3: REDES ────────────────────────────────────── */

.social {
  background: var(--arka-white);
  padding: 60px var(--edge-space);
}

.socialTitle {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--arka-brown-mid);
  margin-bottom: 28px;
}

.socialLinks {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

.socialLink {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  background: var(--arka-white);
  border: 1.5px solid rgba(167, 126, 77, 0.28);
  border-radius: 14px;
  color: var(--arka-brown-mid);
  transition:
    transform 200ms ease,
    box-shadow 200ms ease,
    border-color 200ms ease;
}

.socialLink:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(167, 126, 77, 0.22);
  border-color: var(--arka-brown-mid);
}

.socialLink svg {
  width: 24px;
  height: 24px;
  stroke-width: 1.7;
}

/* ─── RESPONSIVE ─────────────────────────────────────────── */

@media (max-width: 640px) {
  .block {
    padding: 60px var(--edge-space);
  }

  .social {
    padding: 48px var(--edge-space);
  }

  .postulaBtn {
    width: 100%;
    justify-content: center;
  }
}

/* Reducción de movimiento */
@media (prefers-reduced-motion: reduce) {
  .postulaBtn,
  .submitBtn,
  .socialLink {
    transition: none;
  }
}
</file>

