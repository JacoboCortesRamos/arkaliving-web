  max-width: 440px;

  background: var(--arka-white);
  border-radius: 16px;
  padding: 48px 40px 44px;

  display: flex;
  flex-direction: column;
}

/* ─── Botón cerrar ───────────────────────────────────────── */

.close {
  position: absolute;
  top: 16px;
  right: 16px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 36px;
  height: 36px;

  background: transparent;
  border: none;
  border-radius: 8px;
  cursor: pointer;

  color: var(--arka-brown-mid);
