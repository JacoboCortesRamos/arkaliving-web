/* ============================================================
   nosotros.module.css
   Página "Nosotros" — ARKA Living
   Sistema: scroll-reveal con IntersectionObserver
   ============================================================ */

/* ─── BASE DE PÁGINA ─────────────────────────────────────── */

.page {
  padding-top: calc(var(--header-h) + 48px);
  padding-bottom: 120px;
  background: var(--arka-white);
  color: var(--arka-brown-dark);
  overflow-x: hidden;
}

/* ─── SISTEMA DE REVEAL (estados base: invisible) ────────── */
/*
  Cada elemento que debe animarse lleva una de estas clases
  Y TAMBIÉN [data-reveal="stay"|"toggle"] en el HTML.
  El JS añade .revealed cuando entra al viewport.
*/

.revealFade {
  opacity: 0;
  transition: opacity 700ms ease;
}

.revealUp {
  opacity: 0;
  transform: translateY(44px);
  transition:
    opacity 700ms ease,
    transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  /* delay controlado por --delay CSS variable */
  transition-delay: var(--delay, 0ms);
}

.revealScale {
  opacity: 0;
  transform: scaleX(0);
  transform-origin: left center;
  transition:
    opacity 900ms ease,
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
}

/* Estado VISIBLE — añadido por el JS */
.revealed {
  opacity: 1 !important;
  transform: none !important;
}

/* ─── SECCIÓN HERO TITLE ─────────────────────────────────── */

.heroSection {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 var(--edge-space) 80px;
}

.heroTitle {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.heroTitleLine {
  display: block;
  font-family: var(--font-display, Georgia, serif);
  font-size: clamp(38px, 6vw, 80px);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: var(--arka-brown-dark);
}

.heroTitleSoft {
  color: var(--arka-brown-mid);
  font-weight: 400;
  font-style: italic;
}

.heroDivider {
  margin-top: 36px;
  height: 2px;
  width: 72px;
  background: var(--arka-brown-light);
  border-radius: 2px;
}

/* ─── MANIFIESTO ─────────────────────────────────────────── */

.manifesto {
  max-width: 720px;
  margin: 0 auto;
  padding: 0 var(--edge-space) 100px;
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.bodyLarge {
  font-size: clamp(20px, 2.4vw, 26px);
  line-height: 1.45;
  font-weight: 400;
  color: var(--arka-brown-dark);
}

.body {
  font-size: clamp(16px, 1.8vw, 19px);
  line-height: 1.75;
  color: var(--arka-text-soft);
}

/* Pull quote grande */
.pullQuote {
  margin: 0;
  padding: 28px 0 28px 28px;
  border-left: 3px solid var(--arka-brown-light);

  font-family: var(--font-display, Georgia, serif);
  font-size: clamp(26px, 3.4vw, 42px);
  font-weight: 700;
  line-height: 1.15;
  color: var(--arka-brown-dark);
  font-style: normal;
}

/* Pull quote secundario */
.pullQuoteSmall {
  margin: 0;
  padding: 20px 0 20px 24px;
  border-left: 2px solid var(--arka-brown-light);

  font-size: clamp(18px, 2vw, 24px);
  font-weight: 600;
  line-height: 1.3;
  color: var(--arka-brown-mid);
  font-style: italic;
}

/* Insight card */
.insight {
  padding: 28px 32px;
  background: rgba(167, 126, 77, 0.07);
  border: 1px solid rgba(167, 126, 77, 0.18);
  border-radius: 16px;
}

.insightLabel {
  display: block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--arka-brown-mid);
  margin-bottom: 10px;
}

.insightText {
  margin: 0;
  font-family: var(--font-display, Georgia, serif);
  font-size: clamp(22px, 2.8vw, 34px);
  font-weight: 700;
  line-height: 1.2;
  color: var(--arka-brown-dark);
}

/* ─── CREENCIAS ──────────────────────────────────────────── */

.beliefsSection {
  max-width: 720px;
  margin: 0 auto;
  padding: 0 var(--edge-space) 100px;
}

.beliefsTitle {
  font-family: var(--font-display, Georgia, serif);
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--arka-brown-dark);
  margin: 0 0 28px;
}

/* Texto resaltado inline */
.highlight {
  background: rgba(167, 126, 77, 0.13);
  border-bottom: 2px solid var(--arka-brown-light);
  padding: 0 3px 1px;
  border-radius: 3px;
  font-style: normal;
  color: var(--arka-brown-dark);
}

/* Recuadro "ARKA nace para resolver eso" — visual hermano del insight */
.arkaCallout {
  padding: 24px 32px;
  border: 2px solid var(--arka-brown-mid);
  border-radius: 16px;
  background: transparent;
}

.arkaCalloutText {
  margin: 0;
  font-family: var(--font-display, Georgia, serif);
  font-size: clamp(20px, 2.4vw, 28px);
  font-weight: 700;
  color: var(--arka-brown-mid);
  line-height: 1.2;
