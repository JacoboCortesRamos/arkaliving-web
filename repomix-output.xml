/* ============================================================
   ImageLightbox.module.css
   ============================================================ */

/* ── Overlay ─────────────────────────────────────────────── */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(30, 20, 12, 0.92);
  backdrop-filter: blur(6px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* margen fijo arriba (header) y abajo (borde pantalla) */
  padding-top: calc(var(--header-h, 72px) + 16px);
  padding-bottom: 20px;
  padding-left: 0;
  padding-right: 0;
  gap: 12px;
  animation: fadeIn 180ms ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ── Contenedor principal ─────────────────────────────────── */
.box {
  /* ancho = 100% del viewport, sin padding lateral */
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

/* ── Imagen principal ─────────────────────────────────────── */
.main {
  position: relative;
  /* ancho total */
  width: 100%;
  /* alto = espacio disponible entre header, gap y thumbs */
  height: calc(
    100dvh - var(--header-h, 72px) - 16px /* padding-top extra */ - 52px
      /* altura thumbs */ - 12px /* gap entre imagen y thumbs */ - 20px
      /* padding-bottom */
  );
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
  /* sin border-radius para que llegue de borde a borde */
  border-radius: 0;
}

.mainImg {
  object-fit: contain; /* contain: respeta la proporción sin recortar */
  background: transparent;
  transition: opacity 200ms ease;
}

/* ── Botón cerrar — esquina sup derecha DENTRO de la imagen ── */
.close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 10;
  background: rgba(30, 20, 12, 0.55);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  opacity: 0.85;
  cursor: pointer;
  transition:
    opacity 160ms ease,
    background 160ms ease;
}

.close:hover {
  opacity: 1;
  background: rgba(30, 20, 12, 0.8);
}

.closeIcon {
  width: 18px;
  height: 18px;
}

/* ── Flechas ──────────────────────────────────────────────── */
.arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  background: rgba(253, 252, 249, 0.12);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  transition:
    background 180ms ease,
    transform 180ms ease;
}

.arrow:hover {
  background: rgba(253, 252, 249, 0.28);
  transform: translateY(-50%) scale(1.08);
}

.arrowLeft {
  left: 16px;
}
.arrowRight {
  right: 16px;
}

.arrowIcon {
  width: 20px;
  height: 20px;
}

/* ── Counter ──────────────────────────────────────────────── */
.counter {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(30, 20, 12, 0.55);
  backdrop-filter: blur(4px);
  border-radius: 100px;
  padding: 4px 14px;
  font-size: 13px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.04em;
  pointer-events: none;
  white-space: nowrap;
}

/* ── Thumbnails ───────────────────────────────────────────── */
.thumbs {
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  flex-shrink: 0;
  padding: 0 16px;
}

.thumb {
  position: relative;
  width: 72px;
  height: 52px;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition:
    border-color 180ms ease,
    opacity 180ms ease,
    transform 180ms ease;
  opacity: 0.55;
  flex-shrink: 0;
}

.thumb:hover {
  opacity: 0.85;
  transform: translateY(-2px);
}

.thumbActive {
  border-color: var(--arka-brown-light);
  opacity: 1;
}

.thumbImg {
  object-fit: cover;
}

/* ── Mobile ───────────────────────────────────────────────── */
@media (max-width: 640px) {
  .overlay {
    padding-top: calc(var(--header-h, 72px) + 8px);
    padding-bottom: 12px;
    gap: 8px;
  }

  .arrow {
    width: 36px;
    height: 36px;
  }

  .arrowIcon {
    width: 16px;
    height: 16px;
  }

  .thumb {
    width: 56px;
    height: 42px;
  }
}
