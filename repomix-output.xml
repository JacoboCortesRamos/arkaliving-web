  font-size: clamp(17px, 1.9vw, 21px);
  line-height: 1.7;
  color: rgba(253, 252, 249, 0.88);
}

.visionClosure {
  margin: 0;
  font-family: var(--font-display, Georgia, serif);
  font-size: clamp(22px, 2.6vw, 30px);
  font-weight: 700;
  color: var(--arka-white);
  font-style: italic;
